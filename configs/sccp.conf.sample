[general]
authtimeout = 5
guest = no
max_guests = 100
tos = AF31

[SEP0015C66BFD16]
type = device
dateformat = D/M/Y
voicemail = 1002@foobar
vmexten = *98
keepalive = 10
dialtimeout = 5
timezone = America/Winnipeg
line = 1001
speeddial = 1-1
speeddial = 1-2

; multi-line device (i.e. Cisco 6941): one "line" option per line key, in order.
; The first line is the default line used for voicemail and speeddials hints.
[SEP00260B5D4E31]
type = device
line = 1004
line = 1005
speeddial = 1-1

[1001]
type = line
cid_name = Alice
cid_num = 1001
setvar = WAZO_USERID=1
setvar = PICKUPMARK=1001%default
context = default
language = en_US
accountcode = 1001
directmedia = yes
tos_audio = EF
disallow = all
allow = alaw,ulaw
callgroup = 1,3-4
pickupgroup = 1,3-5
namedcallgroup = engineering,sales
namedpickupgroup = sales

[1-1]
type = speeddial
label = Bob
extension = 1002
blf = yes

[1-2]
type = speeddial
label = Carlos
extension = 1003
blf = yes

[1004]
type = line
cid_name = Dave
cid_num = 1004
context = default

[1005]
type = line
cid_name = Dave (2)
cid_num = 1005
context = default
